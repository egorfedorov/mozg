# Copy to .env and fill in. Nothing here may be committed.
#
# The one address the panel opens for. The login link is mailed there.
MOZG_OPERATOR_EMAIL=
# Signs the operator's session and the links in letters. Make one with:
#   openssl rand -hex 32
MOZG_SECRET=
# The mail, through Resend. Without both, mail stays off and the way into the
# panel is `docker compose exec site node dist/site-server.mjs token`.
RESEND_API_KEY=
EMAIL_FROM=
# Optional. The language of the operator's letters: "ru" or "en".
# MOZG_OPERATOR_LANG=ru
