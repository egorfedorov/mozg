{
  "name": "mozg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts --reset",
    "worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "worker:prod": "tsx src/worker/index.ts",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "tsx --test src/lib/*.test.ts",
    "auth:migrate": "npx --yes @better-auth/cli migrate --y",
    "check:access": "tsx --env-file-if-exists=.env scripts/check-access.ts",
    "try:extract": "tsx --env-file-if-exists=.env scripts/try-extract.ts",
    "diagnose": "tsx --env-file-if-exists=.env scripts/diagnose-exam.ts",
    "check:money": "tsx --env-file-if-exists=.env scripts/check-money.ts",
    "check:purchase": "tsx --env-file-if-exists=.env scripts/check-purchase.ts",
    "check:mcp": "tsx --env-file-if-exists=.env scripts/check-mcp.ts",
    "check:refresh": "tsx --env-file-if-exists=.env scripts/check-refresh.ts",
    "seed:stake": "tsx --env-file-if-exists=.env scripts/seed-stake-engine.ts",
    "ask": "tsx --env-file-if-exists=.env scripts/ask.ts",
    "token": "tsx --env-file-if-exists=.env scripts/token.ts",
    "exam": "tsx --env-file-if-exists=.env scripts/exam.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "better-auth": "^1.4.0",
    "next": "16.2.10",
    "pg": "^8.13.1",
    "pg-boss": "^10.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
