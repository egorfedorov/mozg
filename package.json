{
  "name": "mozg",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/migrate.ts --reset",
    "worker": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/worker/index.mjs && esbuild scripts/migrate.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/migrate.mjs",
    "build:tools": "esbuild scripts/paid.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/paid.mjs && esbuild scripts/exam.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/exam.mjs && esbuild scripts/catalogue.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/catalogue.mjs && esbuild scripts/failed-checks.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/failed-checks.mjs && esbuild scripts/requeue.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/requeue.mjs && esbuild scripts/ask.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/ask.mjs && esbuild scripts/probes.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/probes.mjs && esbuild scripts/check-counts.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/check-counts.mjs && esbuild scripts/check-timeline.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/check-timeline.mjs && esbuild scripts/grandfather.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/grandfather.mjs && esbuild scripts/price-pack.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/price-pack.mjs",
    "worker:prod": "node dist/worker/index.mjs",
    "db:migrate:prod": "node dist/migrate.mjs",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "tsx --test src/lib/*.test.ts src/worker/*.test.ts",
    "auth:migrate": "npx --yes @better-auth/cli migrate --y",
    "check:access": "tsx --env-file-if-exists=.env scripts/check-access.ts",
    "try:extract": "tsx --env-file-if-exists=.env scripts/try-extract.ts",
    "diagnose": "tsx --env-file-if-exists=.env scripts/diagnose-exam.ts",
    "check:counts": "tsx --env-file-if-exists=.env scripts/check-counts.ts",
    "check:timeline": "tsx --env-file-if-exists=.env scripts/check-timeline.ts",
    "check:money": "tsx --env-file-if-exists=.env scripts/check-money.ts",
    "grandfather": "tsx --env-file-if-exists=.env scripts/grandfather.ts",
    "price-pack": "tsx --env-file-if-exists=.env scripts/price-pack.ts",
    "check:purchase": "tsx --env-file-if-exists=.env scripts/check-purchase.ts",
    "check:mcp": "tsx --env-file-if-exists=.env scripts/check-mcp.ts",
    "check:refresh": "tsx --env-file-if-exists=.env scripts/check-refresh.ts",
    "ask": "tsx --env-file-if-exists=.env scripts/ask.ts",
    "token": "tsx --env-file-if-exists=.env scripts/token.ts",
    "exam": "tsx --env-file-if-exists=.env scripts/exam.ts",
    "review": "tsx --env-file-if-exists=.env scripts/review.ts",
    "catalogue": "tsx --env-file-if-exists=.env scripts/catalogue.ts",
    "paid": "tsx --env-file-if-exists=.env scripts/paid.ts",
    "check:payments": "NOWPAYMENTS_API_KEY=test-key NOWPAYMENTS_IPN_SECRET=test-secret tsx --env-file-if-exists=.env scripts/check-payments.ts",
    "requeue": "tsx --env-file-if-exists=.env scripts/requeue.ts",
    "check:usage": "tsx --env-file-if-exists=.env scripts/check-usage.ts",
    "lesson": "tsx --env-file-if-exists=.env scripts/lesson.ts",
    "probes": "tsx --env-file-if-exists=.env scripts/probes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@types/qrcode": "^1.5.6",
    "better-auth": "^1.4.0",
    "next": "16.2.10",
    "pg": "^8.13.1",
    "pg-boss": "^10.3.2",
    "posthog-js": "^1.410.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
