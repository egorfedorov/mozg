# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres + pgvector (see README "Setup"). Docker Hub is unreliable from
# some regions, so local brew Postgres is the default path; docker-compose.yml
# still has a db service if you can pull images.
DATABASE_URL=postgres://mozg:mozg@localhost:5432/mozg

# ─── Claude API ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Any Anthropic-compatible endpoint — useful when a card for
# console.anthropic.com is not available. Request/response shapes are identical.
#   ANTHROPIC_BASE_URL=https://api.apimart.ai   (SDK appends /v1/messages itself)
# Vision extraction. Quality of this model IS the quality of the product.
MODEL_EXTRACT=claude-opus-5
# Exam judge — simple compare-to-expectation task, cheap model is fine.
# Note: resellers often expose dated ids. On apimart this one is
# claude-haiku-4-5-20251001; a wrong id fails at runtime with model_not_found.
MODEL_JUDGE=claude-haiku-4-5
# Odd number of judge votes per check, majority wins. 3 removes the ±10-point
# noise between re-sits on unchanged material; 1 is the cheapest run.
JUDGE_VOTES=3
# Send ingest through the Batch API (50% cheaper, up to ~1h latency).
INGEST_USE_BATCH=false
# Downsample screenshots to this long edge before sending (px).
# 1568 keeps image tokens ~1.6k; 2576 is full-res on Opus 5 (~4.8k tokens).
INGEST_IMAGE_MAX_EDGE=1568

# ─── Embeddings ──────────────────────────────────────────────────────────────
# docker compose up -d embed
EMBED_URL=http://localhost:8099
EMBED_DIM=1024
# Cross-encoder reranker (bge-reranker-v2-m3). Served by the same embed
# service, so unset means RERANK_URL=EMBED_URL. Without the weights fetched
# (services/embed/fetch-model.sh reranker) search just skips the rerank pass.
# RERANK_URL=http://localhost:8099

# ─── Storage ─────────────────────────────────────────────────────────────────
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# S3 / Cloudflare R2
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ─── Auth ────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3300
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3300
NEXT_PUBLIC_APP_URL=http://localhost:3300

# Who can open /admin. Comma-separated; empty means nobody.
ADMIN_EMAILS=

# Email, once a provider is wired. Until both are set, password sign-up is
# closed and password reset is unavailable — see src/lib/auth.ts.
EMAIL_FROM=
RESEND_API_KEY=

# Crypto top-ups (NOWPayments). Inert until both are set — the balance page
# falls back to the manual "write to us" flow.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Nightly note consolidation. Off until the similarity threshold is validated
# on real material — see lib/env.ts for the measurement.
CONSOLIDATE_ENABLED=false
