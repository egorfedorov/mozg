# ── mozg, self-hosted ────────────────────────────────────────────────────
#
#   cp .env.selfhost.example .env
#   docker compose -f docker-compose.selfhost.yml up
#
# Then open http://localhost:3300. Only the two values marked REQUIRED
# actually need your attention.

# REQUIRED — the model that reads documentation into notes and judges exams.
# Anthropic by default; any Anthropic-compatible reseller works via
# ANTHROPIC_BASE_URL. Users can also bring their own key per account in
# settings (including OpenAI, Kimi, DeepSeek, Qwen and GLM).
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.apimart.ai

# REQUIRED — session signing. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Where this instance lives. Keep as-is for local use.
BETTER_AUTH_URL=http://localhost:3300
NEXT_PUBLIC_APP_URL=http://localhost:3300

# Cheap and good for reading docs. Swap for claude-sonnet-5 if you would
# rather pay more for slightly better extraction.
MODEL_EXTRACT=claude-haiku-4-5-20251001
MODEL_JUDGE=claude-haiku-4-5-20251001

# Local database and storage — the compose file wires these up for you.
POSTGRES_PASSWORD=mozg
STORAGE_DRIVER=local

# Optional. Without mail, password sign-up is closed and the first account
# is made with `npm run seed` or GitHub OAuth.
# EMAIL_FROM="mozg <hi@example.com>"
# RESEND_API_KEY=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Optional: your admin address unlocks /admin on this instance.
# ADMIN_EMAILS=you@example.com
